# La Capitana — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored, so your keys never get committed.

# --- Email (Resend) -------------------------------------------------
# One account covers both the contact form and the newsletter.
# 1. Sign up at https://resend.com (free tier is plenty to start).
# 2. Create an API key: Dashboard -> API Keys -> Create.
# 3. Create an audience for the newsletter: Dashboard -> Audiences,
#    then copy its Audience ID.

RESEND_API_KEY=

# Where contact-form messages get delivered (your shop inbox).
# While the domain isn't verified yet, use the SAME email you signed
# up to Resend with — that's the only address Resend lets you send to
# in test mode.
CONTACT_TO_EMAIL=

# Optional. Leave blank to send from Resend's test sender.
# Once lacapitana.es is verified in Resend, set e.g.
# "La Capitana <hola@lacapitana.es>".
CONTACT_FROM_EMAIL=

# The newsletter subscriber list.
RESEND_AUDIENCE_ID=
